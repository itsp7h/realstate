{
  // ─────────────────────────────────────────────────────────────────────
  // Shared workspace settings for the Real Estate Laravel project.
  // Committed on purpose so every machine/clone gets the same toolchain.
  // Personal preferences (theme, font size, keybindings) belong in your
  // USER settings, not here.
  // ─────────────────────────────────────────────────────────────────────

  // --- Formatting -------------------------------------------------------
  "editor.formatOnSave": true,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
    "editor.tabSize": 4
  },
  "[blade]": {
    "editor.defaultFormatter": "shufo.vscode-blade-formatter",
    "editor.tabSize": 4
  },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.tabSize": 2 },
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "files.trimTrailingWhitespace": false },

  // --- Blade ------------------------------------------------------------
  "files.associations": {
    "*.blade.php": "blade"
  },
  "blade.format.enable": true,
  "bladeFormatter.format.indentSize": 4,
  "bladeFormatter.format.wrapLineLength": 120,
  "bladeFormatter.format.wrapAttributes": "auto",
  "emmet.includeLanguages": {
    "blade": "html"
  },
  "html.format.enable": false,

  // --- PHP / Intelephense ----------------------------------------------
  // composer.json requires php ^8.2 and local CLI is 8.2.x, so lint against
  // 8.2 even though the servers run 8.3 — catches accidental 8.3-only syntax.
  "intelephense.environment.phpVersion": "8.2.0",
  "intelephense.files.exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/vendor/**/{Test,test,Tests,tests}/**",
    "**/storage/framework/views/**",
    "**/public/build/**",
    "**/graphify-out/**"
  ],
  "intelephense.diagnostics.undefinedTypes": false,
  "intelephense.format.braces": "psr12",
  // Built-in PHP support duplicates Intelephense — turn it off.
  "php.suggest.basic": false,
  "php.validate.enable": false,

  // --- Search / watcher performance ------------------------------------
  // Keeps Cmd+Shift+F and the file watcher off the ~200MB of vendored code.
  "search.exclude": {
    "**/vendor": true,
    "**/node_modules": true,
    "**/public/build": true,
    "**/public/storage": true,
    "**/storage/framework": true,
    "**/storage/logs": true,
    "**/graphify-out": true,
    "**/.playwright-mcp": true,
    "**/composer.lock": true,
    "**/package-lock.json": true
  },
  "files.watcherExclude": {
    "**/vendor/**": true,
    "**/node_modules/**": true,
    "**/public/build/**": true,
    "**/storage/framework/**": true,
    "**/storage/logs/**": true,
    "**/graphify-out/**": true
  },

  // --- Explorer ---------------------------------------------------------
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    ".env": ".env.*",
    "composer.json": "composer.lock, phpunit.xml, pint.json, .php-cs-fixer*",
    "package.json": "package-lock.json, vite.config.js, postcss.config.js, tailwind.config.js, .editorconfig",
    "artisan": ".gitattributes, .gitignore, README.md, CLAUDE.md",
    "*.sqlite": "${capture}.${extname}-*"
  },

  // --- Laravel extensions -----------------------------------------------
  // Run the test suite from the integrated terminal: `php artisan test`
  "LaravelExtraIntellisense.phpCommand": "php -r \"{code}\"",
  "LaravelExtraIntellisense.basePath": ".",
  "laravel_goto_view.folders": {
    "default": "resources/views"
  },
  "laravel_goto_view.quickJump": true
}
